<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>cvx-rando</AssemblyName>
    <RootNamespace>Cvx.Rando.App</RootNamespace>
    <ApplicationIcon>cvx-rando.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <!-- tools/publish.ps1: one self-contained exe -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" Exclude="Assets\Fonts\OFL.txt" />
    <AvaloniaResource Include="cvx-rando.ico" />
    <EmbeddedResource Include="..\..\THIRD_PARTY_NOTICES.md" LogicalName="notices.md" />
    <EmbeddedResource Include="..\..\LICENSE" LogicalName="license.txt" />
    <EmbeddedResource Include="..\..\THIRD_PARTY_NOTICES_SKIASHARP.txt" LogicalName="notices-skiasharp.txt" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cvx.Rando\Cvx.Rando.csproj" />
    <ProjectReference Include="..\Cvx.Formats\Cvx.Formats.csproj" />
  </ItemGroup>

</Project>
