<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Cvx.Rando.App">

  <!-- Type (design handoff §3) -->
  <Style Selector="Window">
    <Setter Property="FontFamily" Value="{StaticResource Ui}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource Text}" />
  </Style>
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="-0.2" />
  </Style>
  <Style Selector="TextBlock.desc">
    <Setter Property="Foreground" Value="{StaticResource Muted}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="MaxWidth" Value="520" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="LineHeight" Value="19" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="TextBlock.note">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource Muted}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="MaxWidth" Value="440" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector="TextBlock.caps">
    <Setter Property="FontFamily" Value="{StaticResource Mono}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{StaticResource Muted}" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{StaticResource Muted}" />
  </Style>
  <Style Selector="TextBlock.warn">
    <Setter Property="Foreground" Value="{StaticResource WarnText}" />
  </Style>
  <Style Selector="TextBlock.ok">
    <Setter Property="Foreground" Value="{StaticResource OkText}" />
  </Style>

  <!-- Keyboard focus: a 2 px accent ring, 2 px outside the control -->
  <Style Selector=":is(Control)">
    <Setter Property="FocusAdorner">
      <FocusAdornerTemplate>
        <Border BorderThickness="2" BorderBrush="#d9473b" CornerRadius="10" Margin="-4" AdornerLayer.IsClipEnabled="False" />
      </FocusAdornerTemplate>
    </Setter>
  </Style>

  <!-- (a text box shows focus with its accent border instead) -->
  <Style Selector="TextBox">
    <Setter Property="FocusAdorner" Value="{x:Null}" />
  </Style>

  <!-- Disabled: a control 45 %, a dependent group 40 % -->
  <Style Selector=":is(Control).dis">
    <Setter Property="Opacity" Value="0.45" />
  </Style>
  <Style Selector=":is(Control).dim">
    <Setter Property="Opacity" Value="0.4" />
  </Style>

  <!-- Settings rows: label and note on the left, the control on the right, a line on top -->
  <Style Selector="Border.row">
    <Setter Property="BorderBrush" Value="{StaticResource RowLine}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="0,16" />
  </Style>
  <Style Selector="Border.row.sub">
    <Setter Property="Padding" Value="16,14,0,14" />
  </Style>
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{StaticResource Surface}" />
    <Setter Property="BorderBrush" Value="{StaticResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Border.chrome">
    <Setter Property="Background" Value="{StaticResource Chrome}" />
    <Setter Property="BorderBrush" Value="{StaticResource Divider}" />
  </Style>
  <Style Selector="Border.gameon">
    <Setter Property="BorderBrush" Value="#2f5a40" />
  </Style>
  <Style Selector="Rectangle.vdiv">
    <Setter Property="Width" Value="1" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Fill" Value="{StaticResource Line}" />
  </Style>

  <!-- Buttons: secondary by default; primary, outline, text, pill, step, nav -->
  <Style Selector="Button">
    <Setter Property="Background" Value="{StaticResource Raised}" />
    <Setter Property="BorderBrush" Value="{StaticResource ButtonLine}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Border"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Name="content"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button:pointerover /template/ Border#PART_Border">
    <Setter Property="Background" Value="#2a2b31" />
  </Style>
  <Style Selector="Button:pressed /template/ Border#PART_Border">
    <Setter Property="Background" Value="#303138" />
  </Style>
  <Style Selector="Button:disabled">
    <Setter Property="Opacity" Value="0.45" />
  </Style>

  <!-- The window's own min/max/close: plain glyphs, 46 px wide, the full title bar high -->
  <Style Selector="CaptionButtons Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Foreground" Value="{StaticResource Text2}" />
    <Setter Property="Cursor" Value="Arrow" />
  </Style>
  <Style Selector="CaptionButtons Button:pointerover /template/ Border#PART_Border">
    <Setter Property="Background" Value="#1fffffff" />
  </Style>
  <Style Selector="CaptionButtons Button:pressed /template/ Border#PART_Border">
    <Setter Property="Background" Value="#33ffffff" />
  </Style>
  <Style Selector="CaptionButtons Button#PART_CloseButton:pointerover /template/ Border#PART_Border">
    <Setter Property="Background" Value="#c42b1c" />
  </Style>
  <Style Selector="CaptionButtons Button#PART_CloseButton:pointerover">
    <Setter Property="Foreground" Value="White" />
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{StaticResource Accent}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="14,8" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ Border#PART_Border">
    <Setter Property="Background" Value="#e2574b" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ Border#PART_Border">
    <Setter Property="Background" Value="#c63e33" />
  </Style>
  <Style Selector="Button.dialog">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="14,8" />
  </Style>
  <Style Selector="Button.big">
    <Setter Property="Height" Value="38" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="Button.big.primary">
    <Setter Property="Padding" Value="18,0" />
    <Setter Property="FontSize" Value="13.5" />
  </Style>
  <Style Selector="Button.outline">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.text">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="4,4" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource Muted}" />
  </Style>
  <Style Selector="Button.text:pointerover /template/ Border#PART_Border">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.text:pointerover">
    <Setter Property="Foreground" Value="{StaticResource Text}" />
  </Style>
  <Style Selector="Button.pill">
    <Setter Property="Background" Value="{StaticResource Surface}" />
    <Setter Property="BorderBrush" Value="{StaticResource Line}" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="Button.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
  </Style>
  <Style Selector="Button.nav:pointerover /template/ Border#PART_Border">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.nav:pressed /template/ Border#PART_Border">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.step">
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <!-- Sidebar rows -->
  <Style Selector="Border.navrow">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Border.navrow:pointerover">
    <Setter Property="Background" Value="#16171a" />
  </Style>
  <Style Selector="Border.navrow.sel">
    <Setter Property="Background" Value="{StaticResource NavSelected}" />
  </Style>
  <Style Selector="Border.navrow TextBlock.navlabel">
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{StaticResource Text2}" />
  </Style>
  <Style Selector="Border.navrow.sel TextBlock.navlabel">
    <Setter Property="Foreground" Value="White" />
  </Style>

  <!-- Switch: 36×20, knob 16; the sidebar's .sm is 32×18, knob 14 -->
  <Style Selector="ToggleButton.switch">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="track" Width="36" Height="20" CornerRadius="10" Background="{StaticResource Off}">
          <Border.Transitions>
            <Transitions>
              <BrushTransition Property="Background" Duration="0:0:0.15" />
            </Transitions>
          </Border.Transitions>
          <Border Name="knob" Width="16" Height="16" CornerRadius="8" Background="White"
                  HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0">
            <Border.Transitions>
              <Transitions>
                <ThicknessTransition Property="Margin" Duration="0:0:0.15" />
              </Transitions>
            </Border.Transitions>
          </Border>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ToggleButton.switch:checked /template/ Border#track">
    <Setter Property="Background" Value="{StaticResource Accent}" />
  </Style>
  <Style Selector="ToggleButton.switch:checked /template/ Border#knob">
    <Setter Property="Margin" Value="18,0,0,0" />
  </Style>
  <Style Selector="ToggleButton.switch.sm /template/ Border#track">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="18" />
    <Setter Property="CornerRadius" Value="9" />
  </Style>
  <Style Selector="ToggleButton.switch.sm /template/ Border#knob">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
    <Setter Property="CornerRadius" Value="7" />
  </Style>
  <Style Selector="ToggleButton.switch.sm:checked /template/ Border#knob">
    <Setter Property="Margin" Value="16,0,0,0" />
  </Style>

  <!-- Toggle chips (weapons) and read-only chips -->
  <Style Selector="ToggleButton.chip">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Margin" Value="0,0,6,6" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="chip" CornerRadius="999" Padding="11,5" BorderThickness="1"
                Background="{StaticResource NavSelected}" BorderBrush="{StaticResource Line}">
          <TextBlock Name="text" Text="{TemplateBinding Content}" FontSize="12" Foreground="{StaticResource Text2}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ToggleButton.chip:pointerover /template/ Border#chip">
    <Setter Property="BorderBrush" Value="#3a3b42" />
  </Style>
  <Style Selector="ToggleButton.chip:checked /template/ Border#chip">
    <Setter Property="Background" Value="#3a1e1c" />
    <Setter Property="BorderBrush" Value="#7a2f29" />
  </Style>
  <Style Selector="ToggleButton.chip:checked /template/ TextBlock#text">
    <Setter Property="Foreground" Value="#f6c3bd" />
  </Style>
  <Style Selector="Border.chipro">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="11,5" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="{StaticResource NavSelected}" />
    <Setter Property="BorderBrush" Value="{StaticResource Line}" />
    <Setter Property="Margin" Value="0,0,6,6" />
  </Style>
  <Style Selector="Border.chipro > TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource Text2}" />
  </Style>

  <!-- Segmented control: a well track, 2 px padding and gap -->
  <Style Selector="ListBox.seg">
    <Setter Property="Background" Value="{StaticResource Well}" />
    <Setter Property="BorderBrush" Value="{StaticResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="SelectionMode" Value="Single,AlwaysSelected" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Orientation="Horizontal" Spacing="2" />
      </ItemsPanelTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ListBox.seg > ListBoxItem">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{StaticResource Muted}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="segbg" CornerRadius="6" Background="Transparent" Padding="{TemplateBinding Padding}">
          <ContentPresenter Name="segtext" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ListBox.seg > ListBoxItem:pointerover">
    <Setter Property="Foreground" Value="{StaticResource Text}" />
  </Style>
  <Style Selector="ListBox.seg > ListBoxItem:selected">
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="ListBox.seg > ListBoxItem:selected /template/ Border#segbg">
    <Setter Property="Background" Value="{StaticResource SegSelected}" />
  </Style>
  <Style Selector="ListBox.seg.tight > ListBoxItem">
    <Setter Property="Padding" Value="10,6" />
  </Style>
  <Style Selector="ListBox.seg.wide > ListBoxItem">
    <Setter Property="Padding" Value="14,6" />
  </Style>

  <!-- Stepper: − value + -->
  <Style Selector="local|Stepper">
    <Setter Property="Template">
      <ControlTemplate>
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Button Name="PART_Dec" Classes="step" Content="−" />
          <TextBlock Grid.Column="1" Text="{Binding Value, RelativeSource={RelativeSource TemplatedParent}}"
                     FontFamily="{StaticResource Mono}" FontSize="14"
                     HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0" />
          <Button Name="PART_Inc" Grid.Column="2" Classes="step" Content="+" />
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="local|Stepper.lg /template/ Button">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
  </Style>

  <!-- Seed and share code wells -->
  <Style Selector="TextBox.well">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- The thin progress bar above the status line -->
  <Style Selector="ProgressBar.thin">
    <Setter Property="Height" Value="4" />
    <Setter Property="MinHeight" Value="4" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Background" Value="{StaticResource RowLine}" />
    <Setter Property="Foreground" Value="{StaticResource Accent}" />
  </Style>

  <!-- Sliders: accent fill -->
  <Style Selector="Slider">
    <Setter Property="Cursor" Value="Hand" />
  </Style>
</Styles>
