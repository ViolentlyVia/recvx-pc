<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Cvx.Rando.App.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <!-- Tokens (design handoff §3); dark only -->
      <SolidColorBrush x:Key="Bg" Color="#141518" />
      <SolidColorBrush x:Key="Chrome" Color="#101113" />
      <SolidColorBrush x:Key="Surface" Color="#18191d" />
      <SolidColorBrush x:Key="NavSelected" Color="#1d1e22" />
      <SolidColorBrush x:Key="Raised" Color="#222328" />
      <SolidColorBrush x:Key="SegSelected" Color="#2e2f36" />
      <SolidColorBrush x:Key="Well" Color="#0f1012" />
      <SolidColorBrush x:Key="Line" Color="#2a2b31" />
      <SolidColorBrush x:Key="Divider" Color="#222328" />
      <SolidColorBrush x:Key="RowLine" Color="#26272c" />
      <SolidColorBrush x:Key="ButtonLine" Color="#33343a" />
      <SolidColorBrush x:Key="Text" Color="#ececee" />
      <SolidColorBrush x:Key="Text2" Color="#c9cad0" />
      <SolidColorBrush x:Key="Muted" Color="#9a9ba3" />
      <SolidColorBrush x:Key="Off" Color="#3a3b42" />
      <SolidColorBrush x:Key="Accent" Color="#d9473b" />
      <SolidColorBrush x:Key="WarnText" Color="#e9c27a" />
      <SolidColorBrush x:Key="WarnBg" Color="#2a2118" />
      <SolidColorBrush x:Key="OkText" Color="#7fd3a0" />
      <FontFamily x:Key="Ui">fonts:Geist#Geist, Segoe UI</FontFamily>
      <FontFamily x:Key="Mono">fonts:Geist#Geist Mono, Consolas</FontFamily>

      <!-- Fluent resources the restyled controls still use -->
      <SolidColorBrush x:Key="SystemControlFocusVisualPrimaryBrush" Color="#d9473b" />
      <SolidColorBrush x:Key="SystemControlFocusVisualSecondaryBrush" Color="Transparent" />
      <Thickness x:Key="SystemControlFocusVisualPrimaryThickness">2</Thickness>
      <Thickness x:Key="SystemControlFocusVisualSecondaryThickness">0</Thickness>
      <Thickness x:Key="SystemControlFocusVisualMargin">-4</Thickness>

      <SolidColorBrush x:Key="SliderTrackFill" Color="#2a2b31" />
      <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#33343a" />
      <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#33343a" />
      <SolidColorBrush x:Key="SliderTrackFillDisabled" Color="#2a2b31" />
      <SolidColorBrush x:Key="SliderTrackValueFill" Color="#d9473b" />
      <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#e2574b" />
      <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#c63e33" />
      <SolidColorBrush x:Key="SliderTrackValueFillDisabled" Color="#d9473b" />
      <SolidColorBrush x:Key="SliderThumbBackground" Color="#d9473b" />
      <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#e2574b" />
      <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#c63e33" />
      <SolidColorBrush x:Key="SliderThumbBackgroundDisabled" Color="#d9473b" />
      <SolidColorBrush x:Key="SliderOuterThumbBackground" Color="#222328" />

      <SolidColorBrush x:Key="TextControlBackground" Color="#0f1012" />
      <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#0f1012" />
      <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#0f1012" />
      <SolidColorBrush x:Key="TextControlBorderBrush" Color="#2a2b31" />
      <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#33343a" />
      <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#d9473b" />
      <SolidColorBrush x:Key="TextControlForeground" Color="#ececee" />
      <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#ececee" />
      <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#ececee" />
      <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>
      <Color x:Key="TextControlSelectionHighlightColor">#7a2f29</Color>

      <SolidColorBrush x:Key="ToolTipBackground" Color="#1b1c20" />
      <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#2f3036" />
      <SolidColorBrush x:Key="ToolTipForeground" Color="#ececee" />
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://cvx-rando/Theme.axaml" />
  </Application.Styles>
</Application>
