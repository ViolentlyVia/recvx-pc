<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Cvx.Rando.App"
        x:Class="Cvx.Rando.App.MainWindow"
        x:DataType="local:MainViewModel"
        Title="CVX Randomizer"
        Icon="/cvx-rando.ico"
        Width="1120" Height="720" MinWidth="960" MinHeight="620"
        Background="{StaticResource Bg}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        ExtendClientAreaTitleBarHeightHint="36">

  <Panel>
    <!-- title bar 36 · command bar 60 · body · footer 68 (design 1b) -->
    <Grid Name="Main" RowDefinitions="36,60,*,68">

      <!-- Title bar: drags the window (not hit-testable); the system draws min/max/close -->
      <Border Classes="chrome" IsHitTestVisible="False">
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,0" VerticalAlignment="Center">
          <Border Width="16" Height="16" CornerRadius="3" ClipToBounds="True">
            <Image Source="/Assets/logo.png" />
          </Border>
          <TextBlock Text="CVX Randomizer" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" />
          <TextBlock Text="{x:Static local:MainViewModel.Version}" Classes="caps" VerticalAlignment="Center" />
        </StackPanel>
      </Border>

      <!-- Command bar: seed, share code, game -->
      <Border Grid.Row="1" Classes="chrome" BorderThickness="0,0,0,1" Padding="16,0">
        <DockPanel VerticalAlignment="Center">
          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="14">
            <TextBlock Text="SEED" Classes="caps" VerticalAlignment="Center" />
            <TextBox Name="SeedBox" Classes="well" Width="120" FontFamily="{StaticResource Mono}" FontSize="16" Padding="10,5"
                     Text="{Binding SeedText}" MaxLength="9" />
            <Button Content="Random" Command="{Binding RandomSeed}" />
            <Rectangle Classes="vdiv" />
            <TextBlock Text="SHARE" Classes="caps" VerticalAlignment="Center" Margin="0,0,0,0" />
          </StackPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="14">
            <Button Content="Copy" Command="{Binding CopyShareCode}" />
            <Button Content="Paste" Command="{Binding PasteShareCode}" />
            <Rectangle Classes="vdiv" />
            <Button Classes="pill" MaxWidth="230" Command="{Binding ChooseGame}" ToolTip.Tip="{Binding GameTooltip}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Ellipse Width="8" Height="8" Fill="{Binding GameDot}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding GameTitle}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
          <!-- the share code: edited in the box; shown shortened with "…" when the box is not focused -->
          <Panel Margin="14,0">
            <TextBox Name="ShareBox" Classes="well" FontFamily="{StaticResource Mono}" FontSize="12.5"
                     Text="{Binding ShareCodeText}" />
            <TextBlock Name="ShareShown" Text="{Binding ShareCodeText}" IsHitTestVisible="False"
                       FontFamily="{StaticResource Mono}" FontSize="12.5" Foreground="{StaticResource Text2}"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="13,0" />
          </Panel>
        </DockPanel>
      </Border>

      <!-- Body: sidebar | settings pane -->
      <Grid Grid.Row="2" ColumnDefinitions="256,*">

        <Border Classes="chrome" BorderThickness="0,0,1,0">
          <DockPanel Margin="12,16">
            <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="12,0">
              <TextBlock Text="{Binding GamePath}" Classes="caps" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding GamePath}" />
              <Button Name="AboutButton" Classes="text" Content="About · licences" Padding="0,2" HorizontalAlignment="Left" />
            </StackPanel>
            <StackPanel Spacing="4">
              <TextBlock Text="THIS SEED" Classes="caps" Margin="10,0,0,8" />
              <ItemsControl ItemsSource="{Binding Nav}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="4" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="local:NavItem">
                    <Border Classes="navrow" Classes.sel="{Binding IsSelected}">
                      <Grid ColumnDefinitions="*,Auto">
                        <Button Classes="nav" Command="{Binding Select}">
                          <StackPanel Spacing="2">
                            <TextBlock Text="{Binding Label}" Classes="navlabel" />
                            <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </Button>
                        <ToggleButton Grid.Column="1" Classes="switch sm" Margin="10,0,0,0"
                                      IsChecked="{Binding On}" IsEnabled="{Binding CanToggle}" Classes.dis="{Binding !CanToggle}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DockPanel>
        </Border>

        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
          <Panel Margin="36,28">

            <!-- Items -->
            <StackPanel IsVisible="{Binding ShowItems}">
              <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,20">
                <StackPanel Spacing="6">
                  <TextBlock Classes="title" Text="Items" />
                  <TextBlock Classes="desc" Text="Moves the pickups around. Key items always keep their logic, so every seed can be finished." />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Top" Margin="24,4,0,0">
                  <TextBlock Text="{Binding ItemsState}" FontSize="12" Classes="muted" VerticalAlignment="Center" />
                  <ToggleButton Classes="switch" IsChecked="{Binding RandomItems}" IsEnabled="{Binding ItemsMasterEnabled}" Classes.dis="{Binding !ItemsMasterEnabled}" />
                </StackPanel>
              </Grid>
              <Border IsVisible="{Binding DoorsLock}" Background="{StaticResource WarnBg}" CornerRadius="8" Padding="12,10" Margin="0,0,0,16">
                <TextBlock Text="Random doors are on, so items are always randomized and only one character plays."
                           Foreground="{StaticResource WarnText}" FontSize="12.5" TextWrapping="Wrap" />
              </Border>
              <StackPanel IsEnabled="{Binding ItemsOn}" Classes.dim="{Binding !ItemsOn}">
                <Border Classes="row">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                      <TextBlock Classes="label" Text="Mode" />
                      <TextBlock Classes="note" Text="{Binding ModeNote}" />
                    </StackPanel>
                    <ListBox Grid.Column="1" Classes="seg" Margin="24,0,0,0"
                             ItemsSource="{x:Static local:MainViewModel.ItemModes}" SelectedIndex="{Binding ItemModeIndex}" />
                  </Grid>
                </Border>
                <Border Classes="row">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                      <TextBlock Classes="label" Text="Include Chris's part" />
                      <TextBlock Classes="note" Text="{Binding ChrisNote}" />
                    </StackPanel>
                    <ToggleButton Grid.Column="1" Classes="switch" Margin="24,0,0,0"
                                  IsChecked="{Binding IncludeChris}" IsEnabled="{Binding IncludeChrisEnabled}" Classes.dis="{Binding !IncludeChrisEnabled}" />
                  </Grid>
                </Border>
                <Border Classes="row">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                      <TextBlock Classes="label" Text="Hidden key items" />
                      <TextBlock Classes="note" Text="Key items may be in out-of-the-way places." />
                    </StackPanel>
                    <ToggleButton Grid.Column="1" Classes="switch" Margin="24,0,0,0" IsChecked="{Binding HiddenKeys}" />
                  </Grid>
                </Border>

                <!-- custom mode only -->
                <Border Classes="row" Padding="0,18">
                  <StackPanel Spacing="14" IsEnabled="{Binding CustomOn}" Classes.dim="{Binding !CustomOn}">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Classes="label" Text="Item mix" />
                      <TextBlock Grid.Column="1" Text="{Binding CustomNote}" FontSize="12" Classes="muted" />
                    </Grid>
                    <local:MixBar Height="8" Weights="{Binding MixWeights}" />
                    <Grid ColumnDefinitions="*,10,*,10,*,10,*">
                      <Border Classes="card" Padding="10">
                        <StackPanel Spacing="8">
                          <DockPanel>
                            <Border Width="8" Height="8" CornerRadius="2" Background="#d9473b" Margin="0,0,6,0" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding AmmoPct}" FontFamily="{StaticResource Mono}" FontSize="12" Classes="muted" />
                            <TextBlock Text="Ammo" FontSize="12" Foreground="{StaticResource Text2}" />
                          </DockPanel>
                          <local:Stepper Minimum="0" Maximum="32" Value="{Binding RatioAmmo}" />
                        </StackPanel>
                      </Border>
                      <Border Grid.Column="2" Classes="card" Padding="10">
                        <StackPanel Spacing="8">
                          <DockPanel>
                            <Border Width="8" Height="8" CornerRadius="2" Background="#4fae74" Margin="0,0,6,0" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding HealthPct}" FontFamily="{StaticResource Mono}" FontSize="12" Classes="muted" />
                            <TextBlock Text="Healing" FontSize="12" Foreground="{StaticResource Text2}" />
                          </DockPanel>
                          <local:Stepper Minimum="0" Maximum="32" Value="{Binding RatioHealth}" />
                        </StackPanel>
                      </Border>
                      <Border Grid.Column="4" Classes="card" Padding="10">
                        <StackPanel Spacing="8">
                          <DockPanel>
                            <Border Width="8" Height="8" CornerRadius="2" Background="#7c8cf0" Margin="0,0,6,0" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding InkPct}" FontFamily="{StaticResource Mono}" FontSize="12" Classes="muted" />
                            <TextBlock Text="Ink ribbons" FontSize="12" Foreground="{StaticResource Text2}" />
                          </DockPanel>
                          <local:Stepper Minimum="0" Maximum="32" Value="{Binding RatioInk}" />
                        </StackPanel>
                      </Border>
                      <Border Grid.Column="6" Classes="card" Padding="10">
                        <StackPanel Spacing="8">
                          <DockPanel>
                            <Border Width="8" Height="8" CornerRadius="2" Background="#d6a54a" Margin="0,0,6,0" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding PowderPct}" FontFamily="{StaticResource Mono}" FontSize="12" Classes="muted" />
                            <TextBlock Text="Gunpowder" FontSize="12" Foreground="{StaticResource Text2}" />
                          </DockPanel>
                          <local:Stepper Minimum="0" Maximum="32" Value="{Binding RatioPowder}" />
                        </StackPanel>
                      </Border>
                    </Grid>
                    <Grid ColumnDefinitions="*,240" Margin="0,6,0,0">
                      <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Classes="label" Text="Ammo per pickup" />
                        <TextBlock Classes="note" Text="8 is the game's own amounts." />
                      </StackPanel>
                      <Grid Grid.Column="1" ColumnDefinitions="*,Auto" Margin="24,0,0,0">
                        <Slider Minimum="1" Maximum="16" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding AmmoQuantity}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Width="28" TextAlignment="Right" Text="{Binding AmmoQuantityText}"
                                   FontFamily="{StaticResource Mono}" VerticalAlignment="Center" Margin="12,0,0,0" />
                      </Grid>
                    </Grid>
                    <StackPanel Spacing="10" Margin="0,6,0,0">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="label" Text="Weapons that may appear" />
                        <TextBlock Grid.Column="1" Text="{Binding WeaponsNote}" FontSize="12" Classes="muted" />
                      </Grid>
                      <ItemsControl ItemsSource="{Binding Weapons}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="local:WeaponChip">
                            <ToggleButton Classes="chip" Content="{Binding Name}" IsChecked="{Binding IsOn}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>
            </StackPanel>

            <!-- Inventory -->
            <StackPanel IsVisible="{Binding ShowInventory}">
              <StackPanel Spacing="6" Margin="0,0,0,20">
                <TextBlock Classes="title" Text="Inventory" />
                <TextBlock Classes="desc" Text="What Claire and Chris carry at the start." />
              </StackPanel>
              <Border Classes="row">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Classes="label" Text="Random starting items" />
                    <TextBlock Classes="note" Text="Each starts with the weapons below, maybe some ammo, and one healing item. Claire keeps her lighter. With random doors, only the one who plays." />
                  </StackPanel>
                  <ToggleButton Grid.Column="1" Classes="switch" Margin="24,0,0,0" IsChecked="{Binding RandomInventory}" />
                </Grid>
              </Border>
              <StackPanel IsEnabled="{Binding RandomInventory}" Classes.dim="{Binding !RandomInventory}">
                <Border Classes="row sub">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                      <TextBlock Classes="label" Text="First weapon" />
                      <TextBlock Classes="note" Text="The knife counts as a sidearm." />
                    </StackPanel>
                    <ListBox Grid.Column="1" Classes="seg tight" Margin="24,0,0,0"
                             ItemsSource="{x:Static local:MainViewModel.WeaponChoices}" SelectedIndex="{Binding Weapon1Index}" />
                  </Grid>
                </Border>
                <Border Classes="row sub">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="label" Text="Second weapon" VerticalAlignment="Center" />
                    <ListBox Grid.Column="1" Classes="seg tight" Margin="24,0,0,0"
                             ItemsSource="{x:Static local:MainViewModel.WeaponChoices}" SelectedIndex="{Binding Weapon2Index}" />
                  </Grid>
                </Border>
              </StackPanel>
              <Border Classes="row">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Classes="label" Text="Start with the side pack" />
                    <TextBlock Classes="note" Text="Two extra item slots for both from the start." />
                  </StackPanel>
                  <ToggleButton Grid.Column="1" Classes="switch" Margin="24,0,0,0" IsChecked="{Binding SidePack}" />
                </Grid>
              </Border>
              <Border Classes="row">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="label" Text="Nosferatu does not poison" VerticalAlignment="Center" />
                  <ToggleButton Grid.Column="1" Classes="switch" Margin="24,0,0,0" IsChecked="{Binding NoPoison}" />
                </Grid>
              </Border>
            </StackPanel>

            <!-- Enemies -->
            <StackPanel IsVisible="{Binding ShowEnemies}">
              <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,20">
                <StackPanel Spacing="6">
                  <TextBlock Classes="title" Text="Enemies" />
                  <TextBlock Classes="desc" Text="Ordinary enemies become other kinds, copied from other rooms. Bosses and enemies that take part in events stay." />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Top" Margin="24,4,0,0">
                  <TextBlock Text="{Binding EnemiesState}" FontSize="12" Classes="muted" VerticalAlignment="Center" />
                  <ToggleButton Classes="switch" IsChecked="{Binding RandomEnemies}" />
                </StackPanel>
              </Grid>
              <StackPanel IsEnabled="{Binding RandomEnemies}" Classes.dim="{Binding !RandomEnemies}">
                <Border Classes="row">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                      <TextBlock Classes="label" Text="Difficulty" />
                      <TextBlock Classes="note" Text="Which kinds come up, and how many may share a room." />
                    </StackPanel>
                    <ListBox Grid.Column="1" Classes="seg" Margin="24,0,0,0"
                             ItemsSource="{x:Static local:MainViewModel.Difficulties}" SelectedIndex="{Binding DifficultyIndex}" />
                  </Grid>
                </Border>
                <Border Classes="row">
                  <StackPanel Spacing="10">
                    <TextBlock Classes="label" Text="Kinds that can appear" />
                    <ItemsControl ItemsSource="{x:Static local:MainViewModel.EnemyKinds}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                          <Border Classes="chipro">
                            <TextBlock Text="{Binding}" />
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </StackPanel>
            </StackPanel>

            <!-- Doors -->
            <StackPanel IsVisible="{Binding ShowDoors}">
              <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,20">
                <StackPanel Spacing="6">
                  <TextBlock Classes="title" Text="Doors" />
                  <TextBlock Classes="desc" Text="Doors lead to other rooms, and one character plays from start to end. The first door leads to a room where you can save. Also randomizes the items." />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Top" Margin="24,4,0,0">
                  <TextBlock Text="{Binding DoorsState}" FontSize="12" Classes="muted" VerticalAlignment="Center" />
                  <ToggleButton Classes="switch" IsChecked="{Binding RandomDoors}" />
                </StackPanel>
              </Grid>
              <StackPanel IsEnabled="{Binding RandomDoors}" Classes.dim="{Binding !RandomDoors}">
                <Border Classes="row">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                      <TextBlock Classes="label" Text="Play as" />
                      <TextBlock Classes="note" MaxWidth="420" Text="{Binding CharNote}" />
                    </StackPanel>
                    <ListBox Grid.Column="1" Classes="seg wide" Margin="24,0,0,0"
                             ItemsSource="{x:Static local:MainViewModel.Characters}" SelectedIndex="{Binding CharacterIndex}" />
                  </Grid>
                </Border>
                <Border Classes="row">
                  <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Classes="label" Text="Segments" />
                        <TextBlock Classes="note" MaxWidth="420" Text="Each one but the last ends at a one-way story door, in random order. The last ends in the game's last room." />
                      </StackPanel>
                      <local:Stepper Grid.Column="1" Classes="lg" Width="92" Margin="24,0,0,0" VerticalAlignment="Center"
                                     Minimum="1" Maximum="{Binding MaxSegments}" Value="{Binding DoorSegments}" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <TextBlock Text="START" Classes="caps" VerticalAlignment="Top" Margin="0,-3,3,0" />
                      <ItemsControl Grid.Column="1" ItemsSource="{Binding SegmentBlocks}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="x:String">
                            <StackPanel Spacing="4" Margin="3,0">
                              <Border Height="6" CornerRadius="3" Background="{StaticResource Accent}" />
                              <TextBlock Text="{Binding}" FontSize="11" Classes="muted" />
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Grid.Column="2" Text="END" Classes="caps" VerticalAlignment="Top" Margin="3,-3,0,0" />
                    </Grid>
                  </StackPanel>
                </Border>
                <Border Classes="row">
                  <Grid ColumnDefinitions="*,260">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                      <TextBlock Classes="label" Text="Segment size" />
                      <TextBlock Classes="note" MaxWidth="400" Text="How much of the game the run uses. More rooms put more doors between start and end. Only rooms in the run hold items." />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6" Margin="24,0,0,0" VerticalAlignment="Center">
                      <Slider Minimum="1" Maximum="8" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding DoorSize}" />
                      <TextBlock Text="{Binding DoorSizeText}" FontSize="12" Foreground="{StaticResource Text2}" HorizontalAlignment="Right" />
                    </StackPanel>
                  </Grid>
                </Border>
              </StackPanel>
            </StackPanel>

            <!-- NPCs -->
            <StackPanel IsVisible="{Binding ShowNpcs}">
              <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,20">
                <StackPanel Spacing="6">
                  <TextBlock Classes="title" Text="NPCs" />
                  <TextBlock Classes="desc" Text="The game's characters take each other's looks and voices (or the looks of BioRand's characters picked below): one new look each, for the whole seed. Claire and Chris stay themselves." />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Top" Margin="24,4,0,0">
                  <TextBlock Text="{Binding NpcsState}" FontSize="12" Classes="muted" VerticalAlignment="Center" />
                  <ToggleButton Classes="switch" IsChecked="{Binding RandomNpcs}" />
                </StackPanel>
              </Grid>
              <StackPanel Classes.dim="{Binding !RandomNpcs}">
                <Border Classes="row">
                  <StackPanel Spacing="10">
                    <TextBlock Classes="label" Text="Who swaps" />
                    <ItemsControl ItemsSource="{x:Static local:MainViewModel.NpcCast}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                          <Border Classes="chipro">
                            <TextBlock Text="{Binding}" />
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
                <Border Classes="row">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="label" Text="Looks" />
                    <TextBlock Classes="note" Text="In every room and cutscene they appear in, a character has the new one's model. Their moves and scenes stay their own." />
                  </StackPanel>
                </Border>
                <Border Classes="row">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="label" Text="Voices" />
                    <TextBlock Classes="note" Text="Each line they speak becomes a line of the new character of about the same length, so the words won't match the subtitles." />
                  </StackPanel>
                </Border>
                <Border Classes="row" IsEnabled="{Binding RandomNpcs}">
                  <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock Classes="label" Text="BioRand characters" />
                        <TextBlock Classes="note" MaxWidth="520" Text="{Binding CharactersNote}" Classes.warn="{Binding !CharactersFound}" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top" Margin="24,0,0,0" IsVisible="{Binding CharactersFound}">
                        <Button Content="RE2 cast" Command="{Binding PickRe2Characters}" />
                        <Button Content="All" Command="{Binding PickAllCharacters}" />
                        <Button Content="None" Command="{Binding PickNoCharacters}" />
                      </StackPanel>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding NpcCharacters}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:CharacterChip">
                          <ToggleButton Classes="chip" Content="{Binding Name}" IsChecked="{Binding IsOn}" ToolTip.Tip="{Binding Tip}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border IsVisible="{Binding HasMissingCharacters}" Background="{StaticResource WarnBg}" CornerRadius="8" Padding="12,10">
                      <TextBlock Text="{Binding MissingCharactersText}" Foreground="{StaticResource WarnText}" FontSize="12.5" TextWrapping="Wrap" />
                    </Border>
                  </StackPanel>
                </Border>
              </StackPanel>
              <Border Classes="row">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Classes="label" Text="BioRand folder" />
                    <TextBlock Classes="note" MaxWidth="520" Text="{Binding MusicFolderText}" Classes.warn="{Binding !MusicFolderFound}" />
                  </StackPanel>
                  <Button Grid.Column="1" Content="Choose…" Command="{Binding ChooseMusicFolder}" Margin="24,0,0,0" VerticalAlignment="Center" />
                </Grid>
              </Border>
            </StackPanel>

            <!-- Music -->
            <StackPanel IsVisible="{Binding ShowMusic}">
              <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,20">
                <StackPanel Spacing="6">
                  <TextBlock Classes="title" Text="Music" />
                  <TextBlock Classes="desc" Text="Tracks swap with others of their kind, from this game and the other games below. Event music stays." />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Top" Margin="24,4,0,0">
                  <TextBlock Text="{Binding MusicState}" FontSize="12" Classes="muted" VerticalAlignment="Center" />
                  <ToggleButton Classes="switch" IsChecked="{Binding RandomMusic}" />
                </StackPanel>
              </Grid>
              <StackPanel IsEnabled="{Binding RandomMusic}" Classes.dim="{Binding !RandomMusic}">
                <Border Classes="row">
                  <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Classes="label" Text="Music from" />
                      <TextBlock Grid.Column="1" Text="{Binding MusicGamesNote}" FontSize="12" Classes="muted" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding MusicGames}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:MusicGameChip">
                          <ToggleButton Classes="chip" Content="{Binding Name}" IsChecked="{Binding IsOn}" ToolTip.Tip="{Binding Tip}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border IsVisible="{Binding HasMissingMusic}" Background="{StaticResource WarnBg}" CornerRadius="8" Padding="12,10">
                      <TextBlock Text="{Binding MissingMusicText}" Foreground="{StaticResource WarnText}" FontSize="12.5" TextWrapping="Wrap" />
                    </Border>
                  </StackPanel>
                </Border>
                <Border Classes="row">
                  <StackPanel Spacing="10">
                    <TextBlock Classes="label" Text="Kinds, and the BioRand tracks that can take their place" />
                    <ItemsControl ItemsSource="{Binding MusicKinds}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <UniformGrid Columns="4" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:MusicKind">
                          <Border Classes="card" Padding="12" Margin="0,0,10,0">
                            <StackPanel Spacing="4">
                              <TextBlock Text="{Binding Name}" FontSize="12.5" Foreground="{StaticResource Text2}" />
                              <TextBlock Text="{Binding Tags}" FontSize="11" FontFamily="{StaticResource Mono}" Classes="muted" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </StackPanel>
              <Border Classes="row">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Classes="label" Text="Title call" />
                    <TextBlock Classes="note" Text="{Binding TitleCallNote}" Classes.warn="{Binding !TitleCallsFound}" />
                  </StackPanel>
                  <ToggleButton Grid.Column="1" Classes="switch" Margin="24,0,0,0" IsChecked="{Binding RandomTitleCall}" />
                </Grid>
              </Border>
              <Border Classes="row">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Classes="label" Text="BioRand folder" />
                    <TextBlock Classes="note" MaxWidth="520" Text="{Binding MusicFolderText}" Classes.warn="{Binding !MusicFolderFound}" />
                  </StackPanel>
                  <Button Grid.Column="1" Content="Choose…" Command="{Binding ChooseMusicFolder}" Margin="24,0,0,0" VerticalAlignment="Center" />
                </Grid>
              </Border>
            </StackPanel>
          </Panel>
        </ScrollViewer>
      </Grid>

      <!-- Footer: options → seed folder → game, status, actions -->
      <Border Grid.Row="3" Classes="chrome" BorderThickness="0,1,0,0" Padding="16,0">
        <DockPanel VerticalAlignment="Center">
          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="8">
            <Border CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource Line}" Background="#16171a" Padding="12,6" MinWidth="112">
              <StackPanel Spacing="1">
                <TextBlock Text="OPTIONS" Classes="caps" />
                <TextBlock Text="{Binding FlowOptions}" FontSize="12.5" FontWeight="Medium" Classes.warn="{Binding FlowOptionsWarn}" />
              </StackPanel>
            </Border>
            <TextBlock Text="→" Foreground="#4a4b52" FontSize="12" VerticalAlignment="Center" />
            <Border CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource Line}" Background="#16171a" Padding="12,6" MinWidth="112">
              <StackPanel Spacing="1">
                <TextBlock Text="SEED FOLDER" Classes="caps" />
                <TextBlock Text="{Binding FlowSeed}" FontSize="12.5" FontWeight="Medium" Classes.muted="{Binding !GameActive}" />
              </StackPanel>
            </Border>
            <TextBlock Text="→" Foreground="#4a4b52" FontSize="12" VerticalAlignment="Center" />
            <Border CornerRadius="8" BorderThickness="1" Background="#16171a" Padding="12,6" MinWidth="112"
                    BorderBrush="{StaticResource Line}" Classes.gameon="{Binding GameActive}">
              <StackPanel Spacing="1">
                <TextBlock Text="GAME" Classes="caps" />
                <TextBlock Text="{Binding FlowGame}" FontSize="12.5" FontWeight="Medium" Classes.ok="{Binding GameActive}" Classes.muted="{Binding !GameActive}" />
              </StackPanel>
            </Border>
          </StackPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="14">
            <Button Classes="text" Content="Folder" Command="{Binding OpenFolder}" IsEnabled="{Binding CanOpen}" />
            <Button Classes="text" Content="Spoiler log" Command="{Binding OpenSpoiler}" IsEnabled="{Binding CanOpen}" />
            <Button Classes="big outline" Content="Play normal game" Command="{Binding PlayNormal}"
                    IsVisible="{Binding GameActive}" IsEnabled="{Binding CanPlayNormal}" />
            <Button Name="GenerateButton" Classes="big" Content="Generate" Click="OnGenerate" IsEnabled="{Binding CanGenerate}" />
            <Button Classes="big primary" Content="{Binding GeneratePlayLabel}" Click="OnGeneratePlay" IsEnabled="{Binding CanGenerate}" />
          </StackPanel>
          <StackPanel Spacing="6" VerticalAlignment="Center" Margin="14,0">
            <ProgressBar Classes="thin" IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
            <TextBlock Text="{Binding StatusText}" FontSize="12" Classes="muted" Classes.warn="{Binding StatusWarn}"
                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding StatusText}" />
          </StackPanel>
        </DockPanel>
      </Border>
    </Grid>

    <!-- In-window dialog: dim overlay, 400 px card -->
    <Grid Name="DialogLayer" IsVisible="False" Background="#99050507">
      <Border Width="400" Padding="22" CornerRadius="12" Background="#1b1c20" BorderBrush="#2f3036" BorderThickness="1"
              BoxShadow="0 20 60 0 #80000000" HorizontalAlignment="Center" VerticalAlignment="Center"
              KeyboardNavigation.TabNavigation="Cycle">
        <StackPanel Spacing="12">
          <TextBlock Name="DialogTitle" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Name="DialogBody" FontSize="13" Foreground="#b5b6bd" TextWrapping="Wrap" LineHeight="19" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button Name="DialogCancel" Classes="dialog" Content="Cancel" />
            <Button Name="DialogOk" Classes="dialog primary" Content="OK" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Licences: a larger card with the licence texts -->
    <Grid Name="LicenceLayer" IsVisible="False" Background="#99050507">
      <Border Margin="56,48" Padding="22" CornerRadius="12" Background="#1b1c20" BorderBrush="#2f3036" BorderThickness="1"
              BoxShadow="0 20 60 0 #80000000" KeyboardNavigation.TabNavigation="Cycle">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Licences" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
          <Button DockPanel.Dock="Bottom" Name="LicenceClose" Classes="dialog primary" Content="Close" HorizontalAlignment="Right" Margin="0,12,0,0" />
          <Border Background="{StaticResource Well}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" Padding="12">
              <SelectableTextBlock Name="LicenceText" FontFamily="{StaticResource Mono}" FontSize="12" Foreground="{StaticResource Text2}" />
            </ScrollViewer>
          </Border>
        </DockPanel>
      </Border>
    </Grid>
  </Panel>
</Window>
