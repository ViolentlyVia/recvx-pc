<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cvx.Formats\Cvx.Formats.csproj" />
  </ItemGroup>

  <!-- OGG decoding for music from BioRand's datapacks (MIT) -->
  <ItemGroup>
    <PackageReference Include="NVorbis" Version="0.10.5" />
  </ItemGroup>

  <!-- The randomizer's data, built into the program so it stays a single exe. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\data\items.json" LogicalName="data/items.json" />
    <EmbeddedResource Include="..\..\data\enemies.json" LogicalName="data/enemies.json" />
    <EmbeddedResource Include="..\..\data\music.json" LogicalName="data/music.json" />
    <EmbeddedResource Include="..\..\data\npcs.json" LogicalName="data/npcs.json" />
    <EmbeddedResource Include="..\..\data\recv\rdt.json" LogicalName="data/recv/rdt.json" />
    <EmbeddedResource Include="..\..\data\recv\enemy.json" LogicalName="data/recv/enemy.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Cvx.Tests" />
  </ItemGroup>

</Project>
