// Enemy randomizer: the enemy types it places and where it copies each one from.
//
// - "type" is the enemy id (bhJumpEnemy index, enNN.c), "version" its model version.
// - "donors" are "<room>#<enemy index>": the model, motions and textures are copied from that
//   enemy (`cvx-rando-cli enemy-donors` lists candidates). Zombies have one donor per skin.
// - "difficulty" 0-3 sets how often the type is picked at each enemy difficulty ("weight"
//   scales that), and "max" the most of it in one room at difficulty 0, 1, 2, 3.
// - "effect" is the enemy's `type` field: its behaviour (0 = normal; other values are states such
//   as eating or sleeping, used by scripted enemies).
{
  "types": [
    {
      "name": "Zombie", "type": 1, "difficulty": 1, "max": [ 4, 6, 8, 10 ],
      "donors": [
        "RM_0070#2", "RM_0070#3", "RM_0030#3", "RM_1070#1", "RM_9060#2", "RM_3200#0", "RM_1120#0",
        "RM_1021#1", "RM_1100#2", "RM_0020#0", "RM_0021#0", "RM_9060#0", "RM_0020#3", "RM_7060#1",
        "RM_9310#0", "RM_6020#1", "RM_6050#0", "RM_9190#1", "RM_6050#1", "RM_3050#1"
      ]
    },
    { "name": "Bat", "type": 7, "difficulty": 0, "weight": 0.3, "max": [ 4, 6, 8, 10 ], "donors": [ "RM_0130#0" ] },
    { "name": "Cerberus", "type": 4, "difficulty": 1, "max": [ 2, 4, 6, 8 ], "donors": [ "RM_3011#0" ] },
    { "name": "Black Widow", "type": 3, "difficulty": 2, "max": [ 1, 2, 3, 4 ], "donors": [ "RM_6090#0" ] },
    { "name": "Bandersnatch", "type": 9, "difficulty": 2, "max": [ 1, 2, 4, 6 ], "donors": [ "RM_1060#0" ] },
    { "name": "Hunter", "type": 5, "version": 0, "difficulty": 3, "max": [ 1, 2, 4, 6 ], "donors": [ "RM_7110#1" ] },
    { "name": "Sweeper", "type": 5, "version": 1, "difficulty": 3, "max": [ 1, 2, 4, 6 ], "donors": [ "RM_7050#0" ] }
  ],

  // Enemy types that may be replaced. Others are bosses, NPCs, traps or event enemies.
  "replaceable": [ 1, 3, 4, 5, 9 ],

  // Script opcodes that act on particular enemies (links to items and objects, rising zombies,
  // synced motions...): rooms that use them keep their enemies.
  "scriptedOpcodes": [
    "set_enemy_item_link", "set_enemy_enemy_link", "set_object_enemy_link", "zombie_up_death_check",
    "set_enemy_life_m", "motion_pos_set_enemy_ply", "enemy_render_set", "enemy_look_flag_set",
    "etc_atari_enemy_pos_set", "enemy_hp_up", "ck_death_event"
  ],

  // Script opcodes that take control of one enemy's work (byte 1 = 1: an enemy, byte 2: its
  // index) to move or animate it in an event: rooms that do this to a replaceable enemy keep
  // their enemies (the event's motions belong to the original type).
  "workOpcodes": [ "load_work", "load_work_ex", "load_work2" ],

  // More rooms that keep their enemies (BioRand ids).
  "keepRooms": []
}
