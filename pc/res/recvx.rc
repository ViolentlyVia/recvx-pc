/* PC port: recvx.exe resources: icon and file version information. */
#include <winver.h>
#include "version.h"

1 ICON "recvx.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION RECVX_VERSION_NUM
PRODUCTVERSION RECVX_VERSION_NUM
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Resident Evil Code: Veronica X (PC port)"
            VALUE "FileVersion", RECVX_VERSION_STR
            VALUE "InternalName", "recvx"
            VALUE "OriginalFilename", "recvx.exe"
            VALUE "ProductName", "recvx-pc"
            VALUE "ProductVersion", RECVX_VERSION_STR
            VALUE "Comments", "PC port built from the recvx decompilation. Needs your own copy of the game."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
